# Copy to .env (never commit .env). Values below are placeholders only.

# Return a clearly labelled demo response instead of calling an AI provider.
DEMO_MODE=true

# Provider implementation: "gemini_rag" (recommended) or "ollama_cloud"
AI_PROVIDER=gemini_rag

# Gemini RAG settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
CHROMA_DIR=./data/chroma
CORPUS_DIR=./data/corpus
RETRIEVAL_TOP_K=4

# Optional: Ollama Cloud settings (legacy/alternative)
OLLAMA_CLOUD_BASE_URL=
OLLAMA_CLOUD_API_KEY=
OLLAMA_MODEL=

# Comma-separated list of allowed CORS origins ("*" = any; fine for local dev).
CORS_ORIGINS=*
